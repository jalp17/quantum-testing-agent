# Configuración de entorno para Quantum Testing Agent
# Copiar este archivo a .env y rellenar los valores reales.

# Vultr
VULTR_API_KEY=tu_clave_api_de_vultr
VULTR_INFERENCE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=false

# Sandbox Docker
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_IMAGE=python:3.11-slim

# Backends cuánticos remotos (opcionales — solo para demo real)
IBM_QUANTUM_TOKEN=tu_token_de_ibm_quantum
AWS_ACCESS_KEY_ID=tu_clave_de_acceso_aws
AWS_SECRET_ACCESS_KEY=tu_clave_secreta_aws
AZURE_QUANTUM_KEY=tu_clave_de_azure_quantum
GOOGLE_QUANTUM_PROJECT_ID=tu_id_de_proyecto_google

# Seguridad
SECRET_KEY=clave_secreta_para_sesiones
ALLOWED_ORIGINS=*
